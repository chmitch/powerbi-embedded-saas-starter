<mxGeometry x="10" y="110" width="230" height="22" as="geometry"/></mxCell><mxCell id="computeText2" value="Reports: customer capacities" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=0;align=center;fontColor=#172f47;" vertex="1" parent="compute"><mxGeometry x="10" y="131" width="230" height="22" as="geometry"/></mxCell><mxCell id="computeText3" value="Shared compute is supported" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=0;align=center;fontColor=#172f47;" vertex="1" parent="compute"><mxGeometry x="10" y="152" width="230" height="22" as="geometry"/></mxCell><mxCell id="note0" value="Conceptual overview | Double arrows show requests and responses, not which service initiates every call." style="text;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="919" width="1180" height="25" as="geometry"/></mxCell><mxCell id="note1" value="One tenant per user. One workspace and embedding principal per tenant. Shared compute never merges permissions." style="text;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="953" width="1180" height="25" as="geometry"/></mxCell><mxCell id="note2" value="Service groups are conceptual, not Azure resource-group boundaries. See the deployment view for physical placement." style="text;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="987" width="1180" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 - Deployment" id="deployment"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1280" pageHeight="1120"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="What gets deployed" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width