x="1" parent="1"><mxGeometry x="50" y="1053" width="1180" height="25" as="geometry"/></mxCell><mxCell id="note3" value="Initial release is single-instance. HA, durable workers, production rotation and unattended CI/CD remain future work." style="text;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="1083" width="1180" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
